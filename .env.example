# ══════════════════════════════════════════════════════════════════
# 权限系统环境变量模板
# 复制为 .env 后按环境修改。强口令留空 → deploy.sh 自动生成（POSTGRES_PASSWORD 等），
# 或手动填强随机值（openssl rand -hex 24）。
#
# ⚠ 数据卷口令固化：POSTGRES_PASSWORD / KEYCLOAK_ADMIN_PASSWORD 只在数据卷首次初始化时生效。
#   若 .env 与既有卷不一致 → 报"perm-postgres 数据卷口令与 .env 不一致"，用 RESET=1 全量重建
#   （会清空数据卷）或恢复原口令。
# ══════════════════════════════════════════════════════════════════

# ── 浏览器可达地址（管理台/Keycloak；部署机对外 IP 或域名） ────────
EXTERNAL_HOST=192.168.1.127

# ── 生产加固开关 ───────────────────────────────────────────────────
# PRODUCTION=true 强制强口令（弱口令会 fail）；联调可 false
PRODUCTION=true

# ── 口令/密钥（留空由 deploy.sh 自动生成强随机值；也可手动填） ─────
POSTGRES_PASSWORD=
PERM_REDIS_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# ── Keycloak 生产模式（KC_START_MODE=start 用外部 postgres；start-dev 用 H2 联调） ──
KC_START_MODE=start
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://perm-postgres:5432/keycloak
KC_DB_USERNAME=perm_user
KC_DB_PASSWORD=                # 与 POSTGRES_PASSWORD 一致（deploy 自动写）
KC_HTTP_ENABLED=true
KC_PROXY=edge
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=   # 与 KEYCLOAK_ADMIN_PASSWORD 一致（deploy 自动写）

# ── 浏览器侧/管理台 URL（deploy 自动按 EXTERNAL_HOST 推导，可覆盖） ──
NEXT_PUBLIC_KEYCLOAK_URL=
NEXT_PUBLIC_PERMISSION_SERVICE_URL=
ALLOWED_ORIGINS=

# ── 可选端口覆盖（默认见 docker-compose.yml） ──────────────────────
# POSTGRES_USER=perm_user
# PERMISSION_SERVICE_HOST_PORT=18080
# PERMISSION_NGINX_PORT=18081
# KEYCLOAK_HOST_PORT=8080
# PERM_POSTGRES_HOST_PORT=25433
# PERM_REDIS_HOST_PORT=16380
# CERBOS_HTTP_PORT=14592
# CERBOS_GRPC_PORT=14593
# KEYCLOAK_REALM=rag-v14
# ADMIN_CONSOLE_HOST_PORT=3002
# TLS_ENABLED=false
