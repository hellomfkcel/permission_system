# ══════════════════════════════════════════════════════════════
# 权限服务后端 — 环境变量模板
# ══════════════════════════════════════════════════════════════
# 复制此文件为 .env 并填入实际值。
# .env 已加入 .gitignore，不会被 Git 追踪。
# P1-1 安全加固：生产环境密钥必须通过环境变量或 Docker secrets 注入，禁止在此文件中明文存放。

# ── 数据库 ──
DATABASE_URL=postgresql+asyncpg://perm_user:perm_pass@localhost:25433/permission_db
DATABASE_URL_SYNC=postgresql://perm_user:perm_pass@localhost:25433/permission_db

# ── Cerbos PDP ──
CERBOS_PDP_URL=http://localhost:13592

# ── Redis (事件发布) ──
REDIS_URL=redis://:your_redis_password@localhost:16380/0

# ── Keycloak ──
KEYCLOAK_SERVER_URL=http://192.168.1.127:8080
KEYCLOAK_REALM=rag-v14
KEYCLOAK_CLIENT_ID=permission-service
# 生产环境推荐通过 Docker secret 文件注入（设置 KEYCLOAK_CLIENT_SECRET_FILE）
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CLIENT_SECRET_FILE=./config/keycloak_client_secret

# ── Keycloak Admin 凭据（user/group sync — master realm fallback）──
# 生产环境通过 K8s Secret / Vault / Docker secret 注入
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
# 或通过 Docker secret 文件注入:
# KEYCLOAK_ADMIN_USERNAME_FILE=/run/secrets/keycloak_admin_username
# KEYCLOAK_ADMIN_PASSWORD_FILE=/run/secrets/keycloak_admin_password

# ── JWT 校签 (与 RAG 系统共用公钥) ──
JWT_PUBLIC_KEY_PATH=/home/mfkcel/proj_rag_dev/config/jwt_public.pem
JWT_ALGORITHM=RS256

# ── ctx_token 签名密钥（HMAC-SHA256）──
# 生产环境必须配置独立密钥（≥32 字符随机字符串）。
# 未配置时回退到 REDIS_URL hash（仅开发兼容）。
# 可通过环境变量或 Docker secret 文件注入：
#   CTX_TOKEN_SECRET=your-production-secret-here
# 或:
#   CTX_TOKEN_SECRET_FILE=/run/secrets/ctx_token_secret
CTX_TOKEN_SECRET=
CTX_TOKEN_SECRET_FILE=./config/ctx_token_secret

# ── 服务间认证 API Key ──
# RAG 系统调用权限服务时携带的预共享密钥。
# 生产环境必须配置（≥32 字符随机字符串）。
# 可通过环境变量或 Docker secret 文件注入：
#   SERVICE_API_KEY=your-production-api-key
# 或:
#   SERVICE_API_KEY_FILE=/run/secrets/service_api_key
SERVICE_API_KEY=
SERVICE_API_KEY_FILE=./config/service_api_key

# ── 服务配置 ──
HOST=0.0.0.0
PORT=18080
LOG_LEVEL=INFO

# ── 生产模式标记 ──
# 设为 true 启用额外安全检查（密钥强制配置、数据库凭据检查等）
PRODUCTION=false
